{
  "rewrites": [
    { "source": "/", "destination": "/site/index.html" },
    { "source": "/styles.css", "destination": "/site/styles.css" },
    { "source": "/trace.js", "destination": "/site/trace.js" },
    { "source": "/favicon.svg", "destination": "/site/favicon.svg" },
    { "source": "/media/(.*)", "destination": "/site/media/$1" },
    { "source": "/science", "destination": "/site/science.html" },
    { "source": "/quality", "destination": "/site/quality.html" },
    { "source": "/raw", "destination": "/site/raw.html" },
    { "source": "/v1/(.*)", "destination": "/api" },
    { "source": "/healthz", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api", "schedule": "0 8 * * *" }
  ]
}
